<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/arc_chip_on" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/arc_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/arc_chip_off" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/arc_border" />
        </shape>
    </item>
</selector>
