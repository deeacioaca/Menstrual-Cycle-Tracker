<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Arc" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/arc_deep</item>
        <item name="colorPrimaryVariant">@color/arc_ink</item>
        <item name="colorOnPrimary">@color/arc_paper</item>
        <item name="colorSecondary">@color/arc_accent</item>
        <item name="colorSecondaryVariant">@color/arc_light</item>
        <item name="colorOnSecondary">@color/arc_ink</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/arc_bg_top</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:textColor">@color/arc_text</item>
    </style>

    <!-- Base for the Arc.* type scale; dotted names inherit from it. -->
    <style name="Arc" />

    <!-- ── Type ─────────────────────────────────────────────────────
         Newsreader (serif, light) speaks in the app's own voice: numbers
         and headings. Hanken Grotesk carries labels, chips and data. -->

    <style name="Arc.Display">
        <item name="android:fontFamily">@font/newsreader_light</item>
        <item name="android:textSize">74sp</item>
        <item name="android:textColor">@color/arc_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Arc.Title">
        <item name="android:fontFamily">@font/newsreader_light</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/arc_ink</item>
    </style>

    <style name="Arc.Heading">
        <item name="android:fontFamily">@font/newsreader_light</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/arc_ink</item>
    </style>

    <style name="Arc.Stat">
        <item name="android:fontFamily">@font/newsreader_light</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/arc_ink</item>
    </style>

    <style name="Arc.Body">
        <item name="android:fontFamily">@font/newsreader_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.55</item>
        <item name="android:textColor">@color/arc_text</item>
    </style>

    <!-- Uppercase micro-label above every card and section -->
    <style name="Arc.Label">
        <item name="android:fontFamily">@font/hanken_light</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/arc_label</item>
    </style>

    <style name="Arc.Caption">
        <item name="android:fontFamily">@font/hanken_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/arc_label</item>
    </style>

    <style name="Arc.Chip">
        <item name="android:fontFamily">@font/hanken_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/arc_chip_text</item>
    </style>

    <style name="Arc.Button">
        <item name="android:fontFamily">@font/hanken_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">17dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/arc_paper</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="WeekdayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/hanken_regular</item>
        <item name="android:textColor">@color/arc_faint</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <style name="FlowOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_flow_option</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:fontFamily">@font/hanken_regular</item>
        <item name="android:textColor">@color/arc_chip_text</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="ArcSwitch">
        <item name="colorControlActivated">@color/arc_deep</item>
    </style>

    <style name="LegendItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="LegendSwatch">
        <item name="android:layout_width">9dp</item>
        <item name="android:layout_height">9dp</item>
        <item name="android:layout_marginEnd">7dp</item>
    </style>

    <style name="LegendLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hanken_light</item>
        <item name="android:textColor">@color/arc_muted</item>
        <item name="android:textSize">11.5sp</item>
    </style>
</resources>
