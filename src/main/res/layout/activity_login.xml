<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="32dp"
    tools:context=".ui.LoginActivity">

    <TextView
        android:id="@+id/back_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/hanken_medium"
        android:padding="8dp"
        android:text="@string/back"
        android:textColor="@color/arc_deep"
        android:textSize="14sp" />

    <TextView
        style="@style/Arc.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/acc" />

    <TextView
        style="@style/Arc.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/email_indent" />

    <EditText
        android:id="@+id/etEmailLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autofillHints="emailAddress"
        android:background="@drawable/bg_field"
        android:fontFamily="@font/hanken_regular"
        android:inputType="textEmailAddress"
        android:padding="16dp"
        android:textColor="@color/arc_ink"
        android:textSize="15sp" />

    <TextView
        style="@style/Arc.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/pswd_indent" />

    <EditText
        android:id="@+id/etPasswordLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autofillHints="password"
        android:background="@drawable/bg_field"
        android:fontFamily="@font/hanken_regular"
        android:inputType="textPassword"
        android:padding="16dp"
        android:textColor="@color/arc_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/button"
        style="@style/Arc.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/btnCont" />

    <TextView
        style="@style/Arc.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/forgot_password"
        android:textAlignment="center" />
</LinearLayout>
