<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="72dp"
    android:paddingEnd="32dp"
    android:paddingBottom="40dp"
    tools:context=".ui.StartActivity">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/logo"
        android:src="@drawable/arc_logo" />

    <TextView
        style="@style/Arc.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/welcome_to_arc"
        android:textSize="32sp" />

    <TextView
        style="@style/Arc.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_tagline"
        android:textSize="13sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/startimg"
        android:src="@drawable/start_image" />

    <TextView
        android:id="@+id/register_button"
        style="@style/Arc.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/start" />

    <TextView
        android:id="@+id/login_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/hanken_medium"
        android:gravity="center"
        android:padding="15dp"
        android:text="@string/acc"
        android:textColor="@color/arc_deep"
        android:textSize="14sp" />
</LinearLayout>
